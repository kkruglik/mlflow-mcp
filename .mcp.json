{
  "mcpServers": {
    "mlflow": {
      "command": "uvx",
      "args": ["mlflow-mcp"],
      "env": {
        "MLFLOW_TRACKING_URI": "http://127.0.0.1:5000"
      }
    },
    "_mlflow-dev": {
      "_comment": "Use this instead of 'mlflow' above when developing from source. Swap the key to 'mlflow' and remove the published entry.",
      "command": "uv",
      "args": ["run", "--project", "/path/to/mlflow-mcp", "mlflow-mcp"],
      "env": {
        "MLFLOW_TRACKING_URI": "http://127.0.0.1:5000"
      }
    }
  }
}
